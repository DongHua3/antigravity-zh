[
  {
    "pattern": "^No\\s+agents?\\s+running$",
    "flags": "i",
    "replace": "无正在运行的智能体",
    "description": "托盘与状态栏：无正在运行的智能体"
  },
  {
    "pattern": "^(\\d+)\\s+agents?\\s+running$",
    "flags": "i",
    "replace": "$1 个智能体正在运行",
    "description": "托盘与状态栏：多个正在运行的智能体"
  },
  {
    "pattern": "^(\\d+)\\s+agent\\(s\\)\\s+running$",
    "flags": "i",
    "replace": "$1 个智能体正在运行",
    "description": "托盘与状态栏：智能体运行数 (带括号形式)"
  },
  {
